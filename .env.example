# Server only. Obtain a commercial EODHD agreement covering public display.
EODHD_API_KEY=
MARKET_PROVIDER=eodhd
# Optional Marketstack connection. The user's free plan is for LOCAL PREVIEW ONLY.
MARKETSTACK_API_KEY=
MARKETSTACK_CACHE_SECONDS=604800
MARKETSTACK_MONTHLY_BUDGET=80
# Single-process persistent cache; use REDIS_URL for multiple replicas.
MARKET_CACHE_DIR=./artifacts/market-cache
# Markets enabled under your agreement; US is the reference site's market.
MARKET_EXCHANGES=US
PORT=3000
HOST=127.0.0.1
# Required for multi-instance deployments; optional for local/single-instance use.
REDIS_URL=
# Never enables demo data implicitly. A demo key is rejected in production.
NODE_ENV=development
PROVIDER_REQUESTS_PER_MINUTE=120
